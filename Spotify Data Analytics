SELECT *
FROM BIT_DB.Spotifydata;

--Determine the avg popularity, danceability, energy

SELECT avg(danceability),
avg(popularity),
avg(energy),
artist_name, track_name
From BIT_DB.Spotifydata
group by artist_name;

--Calculate the average popularity for the artists in the Spotify data table. 
  Then, for every artist with an average popularity of 90 or above, show their name, their average popularity, and label them as a “Top Star”. USING CTE

WITH popularity_average_CTE AS (
SELECT s.artist_name,
AVG(S.popularity) AS avg_pop
FROM Spotifydata s
GROUP BY s.artist_name
)

SELECT artist_name,
        avg_pop,
        'Top Star' AS Tag
FROM popularity_average_CTE
WHERE avg_pop>=90;
